# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Cron Security ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Add this same value to Vercel project env vars so Vercel can call the cron route
CRON_SECRET=your-32-char-random-secret

# ─── Claude / Anthropic ─────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Gemini / Google AI ─────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ─── Google Calendar ────────────────────────────────────────────────────────
# Calendar ID: open Google Calendar > Settings > your calendar > "Calendar ID"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Service account JSON (base64 encoded):
#   1. Create a service account in Google Cloud Console
#   2. Share your Google Calendar with the service account email
#   3. Download the JSON key file
#   4. Encode it: base64 -i your-key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json

# ─── WordPress ──────────────────────────────────────────────────────────────
# WP Admin > Users > Profile > Application Passwords (scroll to bottom)
WP_BASE_URL=https://affirmative.blog/wp-json/wp/v2
WP_USERNAME=your-wordpress-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Default category ID for affirmation posts (WP Admin > Posts > Categories)
WP_DEFAULT_CATEGORY_ID=1

# ─── Big Cartel ─────────────────────────────────────────────────────────────
# Account ID: visible in your Big Cartel account URL or settings
BIGCARTEL_ACCOUNT_ID=your-account-id
# Access token: Big Cartel > Account > API
BIGCARTEL_ACCESS_TOKEN=your-access-token
# Default product price in USD
BIGCARTEL_DEFAULT_PRICE=24.99
